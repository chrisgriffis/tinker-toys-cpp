############################################
# Misc garbage often in recovered repos
############################################
Thumbs.db
Desktop.ini
*.tmp
*.temp
*.bak
*.old
*.orig

############################################
# Optional: keep root-level intentional dirs
# (uncomment if needed)
############################################
#!/src/
#!/include/

# Old VS junk
*.ncb
*.sdf
*.opensdf

# Build logs that slip through
BuildLog.htm

# Executables and outputs
*.exe
*.out

# Weird conflict artifacts
*conflicted copy*

# Random generated DBs
*.VC.db
*.VC.opendb

# TLOG folders explicitly (some cases)
**/*.tlog/

# Embedded manifest junk
*.manifest
*.dep